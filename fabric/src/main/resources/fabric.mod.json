{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "icon": "assets/stellarodyssey/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.amaro.stellarodyssey.fabric.StellarOdysseyFabric"],
    "client": ["com.amaro.stellarodyssey.fabric.client.StellarOdysseyFabricClient"]
  },
  "depends": {
    "java": ">=25",
    "minecraft": "~${minecraft_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "architectury": ">=${architectury_api_version}"
  }
}
